#!/bin/sh
# Main changes go through GitHub pull requests, including for the repository owner.
while read -r local_ref local_oid remote_ref remote_oid; do
    if [ "$remote_ref" = "refs/heads/main" ]; then
        printf '%s\n' 'Direct pushes to main are blocked. Push a feature branch and create a pull request.' >&2
        exit 1
    fi
done
