<Window x:Class="SimpleVideoEditor.RelinkWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Locate recordings" Width="660" Height="460" MinWidth="540" MinHeight="360" WindowStartupLocation="CenterOwner">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16"><TextBlock Text="Locate recordings" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="RemainingText" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/></StackPanel>
  <ListBox x:Name="MissingList" Grid.Row="1" ItemsSource="{Binding Missing}" Background="{StaticResource PanelBrush}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Missing recordings">
   <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="#20272D" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#25D9E9"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
   <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Original}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,4" ToolTip="{Binding Original}"/><TextBlock Text="{Binding ReplacementLabel}" TextTrimming="CharacterEllipsis" Foreground="#A8E6C8" FontSize="11" ToolTip="{Binding Replacement}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <Button x:Name="LocateButton" Grid.Row="2" Content="Locate file…" Click="Locate_Click" HorizontalAlignment="Left" Margin="0,12,0,12" ToolTip="Selecting a file also finds recordings with matching names in the same folder"/>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/><Button x:Name="OpenButton" Content="Open project" Click="Open_Click" IsEnabled="False" IsDefault="True" Style="{StaticResource PrimaryButton}"/></StackPanel>
 </Grid>
</Window>
