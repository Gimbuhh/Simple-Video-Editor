<Window x:Class="SimpleVideoEditor.CacheWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Preview cache" Width="490" Height="360" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" Closing="Window_Closing">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><TextBlock Text="Preview cache" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Thumbnails and waveforms are recreated when needed." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
  <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/></Grid.RowDefinitions><TextBlock Text="Thumbnails" VerticalAlignment="Center"/><TextBlock x:Name="ThumbnailSizeText" Text="…" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/><TextBlock Grid.Row="1" Text="Waveforms" VerticalAlignment="Center"/><TextBlock x:Name="WaveformSizeText" Grid.Row="1" Text="…" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/><TextBlock Grid.Row="2" Text="Total" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="TotalSizeText" Grid.Row="2" Text="…" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/></Grid></Border>
  <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,8" TextWrapping="Wrap"/>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CloseButton" Content="Close" Click="Close_Click" Margin="0,0,8,0"/><Button x:Name="ClearButton" Content="Clear cache" Click="Clear_Click" IsEnabled="False"/></StackPanel>
 </Grid>
</Window>
