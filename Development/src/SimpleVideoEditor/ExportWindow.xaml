<Window x:Class="SimpleVideoEditor.ExportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Export video" Width="540" Height="560" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Closing="Window_Closing">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Export your video" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="SummaryText" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,20"/></StackPanel>
    <StackPanel Grid.Row="1">
      <StackPanel x:Name="OptionsPanel">
        <TextBlock Text="Save to" Margin="0,0,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="OutputInput" IsReadOnly="True" AutomationProperties.Name="Output file"/><Button Grid.Column="1" Content="Browse…" Click="Browse_Click" Margin="8,0,0,0"/></Grid>
        <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Format" Margin="0,0,0,6"/><ComboBox x:Name="CodecInput" SelectedIndex="0" AutomationProperties.Name="Export codec"><ComboBoxItem Content="AV1 · smaller files"/><ComboBoxItem Content="H.264 · compatibility"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Quality" Margin="0,0,0,6"/><ComboBox x:Name="QualityInput" SelectedIndex="0" SelectionChanged="Quality_Changed" AutomationProperties.Name="Export quality"><ComboBoxItem Content="High"/><ComboBoxItem Content="Balanced"/><ComboBoxItem Content="Smaller file"/></ComboBox></StackPanel></Grid>
        <TextBlock x:Name="QualityHint" Text="Best detail; larger files." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,8,0,0"/>
        <TextBlock Text="Resolution" Margin="0,18,0,6"/><ComboBox x:Name="ResolutionInput" SelectedIndex="0" AutomationProperties.Name="Output resolution"><ComboBoxItem x:Name="OriginalResolutionItem" Content="Same as first clip"/><ComboBoxItem Content="1920 × 1080"/><ComboBoxItem Content="1280 × 720"/></ComboBox>
        <CheckBox x:Name="GpuInput" Content="Use NVIDIA hardware encoding" ToolTip="Turn off to use CPU encoding" IsChecked="True" Margin="0,18,0,0"/>


      </StackPanel>
      <ProgressBar x:Name="ProgressBar" Height="7" Margin="0,18,0,0" Minimum="0" Maximum="1" Foreground="#A8E6C8" Background="#293139" BorderThickness="0" Visibility="Collapsed"/>
      <TextBlock x:Name="ProgressText" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="RevealButton" Content="Show file" Click="Reveal_Click" Visibility="Collapsed" Margin="0,0,8,0"/><Button x:Name="CancelButton" Content="Close" Click="Cancel_Click" Margin="0,0,8,0"/><Button x:Name="StartButton" Content="Export video" Click="Start_Click" Style="{StaticResource PrimaryButton}"/></StackPanel>
  </Grid>
</Window>
